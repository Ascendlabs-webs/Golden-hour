# ---- GoldenHour AI environment (copy to .env, never commit secrets) ----
APP_MODE=demo

# Google Earth Engine (optional). App works in DEMO MODE when false/missing.
EARTH_ENGINE_ENABLED=false
GEE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Satellite provider: sentinel (Copernicus Data Space). Optional credentials.
SATELLITE_PROVIDER=sentinel
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# GIS / population
OSM_ENABLED=true
POPULATION_PROVIDER=worldpop
WORLDPOP_TIF=

# Study area (Chennai defaults; override to expand to other cities)
STUDY_AREA_NAME=Chennai
STUDY_AREA_LAT=13.0475
STUDY_AREA_LON=80.2013
STUDY_AREA_MIN_LON=80.05
STUDY_AREA_MIN_LAT=12.90
STUDY_AREA_MAX_LON=80.32
STUDY_AREA_MAX_LAT=13.25
GRID_ROWS=6
GRID_COLS=6

# GHS weights (must sum ~1.0)
GHS_W_POPULATION=0.24
GHS_W_URGENCY=0.23
GHS_W_VULNERABILITY=0.18
GHS_W_SEVERITY=0.17
GHS_W_CONFIDENCE=0.11
GHS_W_ACCESSIBILITY=0.07

# Algorithmic report-confidence thresholds (base 8, +23 per evidence flag)
CONF_THRESHOLD_HIGH=85
CONF_THRESHOLD_MODERATE=65
CONF_THRESHOLD_MEDIUM=45

# Satellite ingestion (open STAC search needs NO credentials)
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
COPERNICUS_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
S1_COLLECTION=sentinel-1-rtc
S2_COLLECTION=sentinel-2-l2a
SATELLITE_REFRESH_MINUTES=60
SATELLITE_SCHEDULER_ENABLED=true
FRESHNESS_MINUTES=180

# Persistence / frontend
DATABASE_URL=sqlite:///./goldenhour.db
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
